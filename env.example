NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-05
# Server-only. Viewer token for draft mode / Visual Editing (sanity.io/manage → API → Tokens).
SANITY_API_READ_TOKEN=
# Server-only. Shared secret for the Sanity publish webhook → /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Canonical origin for metadata, sitemap, robots, JSON-LD, and social cards (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://wyeast.studio
# Set automatically by Vercel. `preview` and `development` deployments are noindex with a disallow-all robots.txt;
# leave unset locally so builds behave like production.
# VERCEL_ENV=
