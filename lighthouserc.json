{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=3200 npm run start",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3200/", "http://localhost:3200/page-builder-demo"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3200/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3200/page-builder-demo$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:seo": ["warn", { "minScore": 1, "aggregationMethod": "median-run" }],
            "is-crawlable": ["warn", { "minScore": 1, "aggregationMethod": "median-run" }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "robots-txt": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
